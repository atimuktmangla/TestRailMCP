# Copy to ".env" and fill in real values. Loaded automatically by testrail_mcp (see testrail_mcp/settings.py).
# Env prefix: TESTRAIL_

# Base URL of your TestRail site (no trailing slash)
TESTRAIL_URL=https://your-company.testrail.io

# Your TestRail login email (or username) — same as MCP env TESTRAIL_USER
TESTRAIL_USER=your.email@company.com

# PAT: TestRail "API Key" (My Settings → API Key). Same value as MCP env TESTRAIL_API_KEY
TESTRAIL_API_KEY=replace-with-your-PAT-or-api-key

# Optional. Timeout for calls to the TestRail REST API (default 60)
# TESTRAIL_REQUEST_TIMEOUT_SECONDS=60

# MCP transport: stdio (default) or http (Streamable HTTP + uvicorn)
# TESTRAIL_MCP_TRANSPORT=stdio

# Used when TESTRAIL_MCP_TRANSPORT=http — MCP listener (not TestRail)
# TESTRAIL_HTTP_HOST=127.0.0.1
# TESTRAIL_HTTP_PORT=8765
# TESTRAIL_HTTP_PATH=/mcp
# TESTRAIL_HTTP_STATELESS=true
